{
  "configurations": [
    {
      "name": "Linux ARM Cortex-M7",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/../Libraries/**"
      ],
      "defines": [
        "CPU_MIMXRT1064DVL6A",
        "DEBUG"
      ],
      "compilerPath": "/usr/bin/arm-none-eabi-gcc",
      "compilerArgs": [
        "-mcpu=cortex-m7",
        "-mthumb",
        "-mfpu=fpv5-d16",
        "-mfloat-abi=hard"
      ],
      "cStandard": "c99",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-arm",
      "compileCommands": "${workspaceFolder}/GCC/build/compile_commands.json"
    }
  ],
  "version": 4
}
