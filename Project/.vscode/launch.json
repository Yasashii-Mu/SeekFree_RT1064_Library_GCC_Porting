{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RT1064 · CMSIS-DAP / pyOCD",
      "cwd": "${workspaceFolder}/GCC",
      "executable": "${workspaceFolder}/GCC/debug/tutorial.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "pyocd",
      "serverpath": "${workspaceFolder}/../.pyocd-venv/bin/pyocd",
      "armToolchainPath": "/usr/bin",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "targetId": "mimxrt1064",
      "interface": "swd",
      "serverArgs": [
        "--frequency",
        "1000000",
        "--no-wait",
        "-O",
        "reset_type=sysresetreq",
        "-O",
        "soft_bkpt_as_hard=true"
      ],
      "runToEntryPoint": "main",
      "svdFile": "${workspaceFolder}/GCC/MIMXRT1064.xml",
      "preLaunchTask": "build"
    }
  ]
}
